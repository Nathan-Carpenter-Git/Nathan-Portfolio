@model ContactUserMessage
@using NathanPortfolio.Controllers
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Contact";
    ViewData["Description"] = "Get in touch with Nathan Carpenter about IT, networking, or cloud infrastructure opportunities.";
    string responseMessage = Context.Request.Query["ResponseMessage"].ToString();
    string turnstileSiteKey = Configuration["Turnstile:SiteKey"] ?? "";
}

<section class="nc-section contact-section">
    <div class="section-label">04</div>
    <h1 class="section-heading">Get In <span>Touch</span></h1>

    <div class="contact-grid">

        <!-- ── Left: info panel ── -->
        <div>
            <p class="contact-info-label">
                Have a question, opportunity, or just want to say hello?<br />
                Fill out the form, or connect with me directly through the links below
            </p>

            <div class="contact-info-links">
                <a href="https://www.linkedin.com/in/nathan-b-carpenter/" target="_blank" rel="noopener" class="contact-info-link">
                    <div class="contact-info-link-icon">
                        <picture>
                            <source srcset="/shared/icons/icon_linkedin.webp" type="image/webp" />
                            <img src="/shared/icons/icon_linkedin.png" alt="LinkedIn" width="18" height="18" asp-append-version="true" />
                        </picture>
                    </div>
                    <div class="contact-info-link-text">
                        <span class="contact-info-link-title">LinkedIn</span>
                        <span class="contact-info-link-value">nathan-b-carpenter</span>
                    </div>
                </a>

                <a href="https://github.com/Nathan-Carpenter-Git" target="_blank" rel="noopener" class="contact-info-link">
                    <div class="contact-info-link-icon">
                        <picture>
                            <source srcset="/shared/icons/icon_github.webp" type="image/webp" />
                            <img src="/shared/icons/icon_github.png" alt="GitHub" width="18" height="18" asp-append-version="true" />
                        </picture>
                    </div>
                    <div class="contact-info-link-text">
                        <span class="contact-info-link-title">GitHub</span>
                        <span class="contact-info-link-value">Nathan-Carpenter-Git</span>
                    </div>
                </a>

                <a href="https://dusty-studios.itch.io" target="_blank" rel="noopener" class="contact-info-link">
                    <div class="contact-info-link-icon">
                        <picture>
                            <source srcset="/shared/icons/icon_itchio.webp" type="image/webp" />
                            <img src="/shared/icons/icon_itchio.png" alt="itch.io" width="18" height="18" asp-append-version="true" />
                        </picture>
                    </div>
                    <div class="contact-info-link-text">
                        <span class="contact-info-link-title">itch.io</span>
                        <span class="contact-info-link-value">dusty-studios</span>
                    </div>
                </a>
            </div>
        </div>

        <!-- ── Right: form card ── -->
        <div class="contact-form-card reveal">
            <div class="contact-form-header">
                <span class="form-header-dot"></span>
                <span class="form-header-dot"></span>
                <span class="form-header-dot"></span>
                <span class="form-header-label">// new-message.txt</span>
            </div>

            <div class="contact-form-body">

                @if (!String.IsNullOrEmpty(responseMessage))
                {
                    if (responseMessage == ContactController.FailedMessage)
                    {
                        <div class="nc-response nc-response-error">
                            ✕ &nbsp;@responseMessage. Please try again.
                        </div>
                    }
                    else if (responseMessage == ContactController.CaptchaFailedMessage)
                    {
                        <div class="nc-response nc-response-error">
                            ✕ &nbsp;@responseMessage. Please complete the check and try again.
                        </div>
                    }
                    else if (responseMessage == ContactController.SentMessage)
                    {
                        <div class="nc-response nc-response-success">
                            ✓ &nbsp;@responseMessage. I'll be in touch soon!
                        </div>
                    }
                }

                <form method="post" id="contact-form">

                    <div class="form-row-2">
                        <div class="nc-form-group">
                            <label class="nc-label" for="firstName">First Name</label>
                            <input type="text" id="firstName" name="firstName" asp-for="FirstName"
                                   class="nc-input" placeholder="John" required />
                        </div>

                        <div class="nc-form-group">
                            <label class="nc-label" for="lastName">Last Name</label>
                            <input type="text" id="lastName" name="lastName" asp-for="LastName"
                                   class="nc-input" placeholder="Doe" required />
                        </div>
                    </div>

                    <div class="nc-form-group">
                        <label class="nc-label" for="email">Email Address</label>
                        <input type="email" id="email" name="email" asp-for="Email"
                               class="nc-input" placeholder="john@example.com" required />
                    </div>

                    <div class="nc-form-group">
                        <label class="nc-label" for="message">Message</label>
                        <textarea id="message" name="message" asp-for="Message"
                                  class="nc-textarea" placeholder="Enter your message..."></textarea>
                    </div>

                    <div class="nc-captcha" id="contact-captcha" data-sitekey="@turnstileSiteKey"></div>

                    <input type="submit" class="nc-submit" value="Send Message" />

                </form>
            </div>
        </div>

    </div>
</section>

<script nonce="@Context.Items["csp-nonce"]">
    // Turnstile's full-width widget needs at least 300px, so narrow phones get the compact one.
    window.onTurnstileLoad = function () {
        const el = document.getElementById('contact-captcha');
        const compact = el.clientWidth < 300;
        el.classList.toggle('nc-captcha-compact', compact);
        turnstile.render(el, {
            sitekey: el.dataset.sitekey,
            theme: 'dark',
            size: compact ? 'compact' : 'flexible'
        });
    };
</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad" nonce="@Context.Items["csp-nonce"]" async defer></script>

<script nonce="@Context.Items["csp-nonce"]">
    // Trigger reveal animation on the form card
    const revealEls = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('visible');
        });
    }, { threshold: 0.1 });
    revealEls.forEach(el => observer.observe(el));
</script>
